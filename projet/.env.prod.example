# ============================================
# Configuration Production - TalChif
# ============================================
# Copier ce fichier en .env.prod et renseigner les vraies valeurs.
# Seules les variables reellement lues par le code figurent ici.

# ── Application ──
APP_ENV=prod
# 0 obligatoire en production : APP_DEBUG=1 expose les traces d'exception.
APP_DEBUG=0
# php bin/console secrets:generate-keys  ou  openssl rand -hex 32
APP_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET_HERE
APP_SHARE_DIR=var/share

# ── URL publique (generation d'URL hors contexte HTTP : commandes, emails) ──
DEFAULT_URI=https://talchif.td

# ── Base de donnees PostgreSQL ──
# docker-compose.prod.yml assemble DATABASE_URL a partir de ces trois valeurs.
DB_NAME=talchif
DB_USER=talchif_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Email ──
MAILER_DSN=smtp://user:pass@smtp.example.com:587

# ── Queue / Messenger (asynchrone) ──
MESSENGER_TRANSPORT_DSN=doctrine://default?queue_name=async

# ── PawaPay (agregateur Mobile Money) ──
# PAWAPAY_WEBHOOK_SECRET est obligatoire : sans lui l'endpoint
# POST /webhook/pawapay repond 503 (verification HMAC fail-closed).
PAWAPAY_API_TOKEN=CHANGE_ME_PAWAPAY_TOKEN
PAWAPAY_BASE_URL=https://api.pawapay.io
PAWAPAY_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_HMAC_SECRET

# ── WhatsApp (Meta Cloud API) - optionnel ──
WHATSAPP_ENABLED=0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Role applicatif PostgreSQL ──
# Cree par : php bin/console app:securite:role-applicatif
# DATABASE_URL doit ensuite pointer sur ce role (talchif_app), le compte
# proprietaire restant reserve aux migrations. C'est la condition pour que
# les politiques Row Level Security s'appliquent.
APP_DB_ROLE_PASSWORD=CHANGE_ME_DB_ROLE_PASSWORD

# ── CORS ──
# Liste blanche d'origines separees par des virgules. Vide = aucun en-tete CORS
# emis (comportement par defaut le plus sur).
APP_CORS_ALLOW_ORIGIN=
