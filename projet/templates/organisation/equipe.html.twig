{% extends 'layout/dashboard.html.twig' %}

{% set section = 'organisateur' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/organisation/index.css') }}">
{% endblock %}

{% block title %}Equipe - {{ organisation.nom }}{% endblock %}

{% block dashboard_title %}Equipe - {{ organisation.nom }}{% endblock %}

{% block dashboard_actions %}
    <a class="btn btn-secondary btn-sm" href="{{ path('organisation.index') }}">Mes organisations</a>
{% endblock %}

{% block dashboard_content %}
<div class="org-equipe">
    {% if not estProprietaire %}
        <p class="org-note">
            Seul un proprietaire peut modifier l'equipe. Vous consultez cette page en lecture.
        </p>
    {% endif %}

    <section class="card">
        <h2 class="card-title">Membres ({{ membres|length }})</h2>

        <table class="table">
            <thead>
                <tr>
                    <th>Membre</th>
                    <th>Role</th>
                    <th>Depuis</th>
                    {% if estProprietaire %}<th>Actions</th>{% endif %}
                </tr>
            </thead>
            <tbody>
                {% for membre in membres %}
                    <tr>
                        <td>
                            <strong>{{ membre.utilisateur.nom ?: membre.utilisateur.email }}</strong><br>
                            <small>{{ membre.utilisateur.email }}</small>
                        </td>
                        <td>
                            {% if estProprietaire %}
                                <form method="post" action="{{ path('organisation.equipe.role', {id: membre.id}) }}" class="org-inline-form">
                                    <input type="hidden" name="_token" value="{{ csrf_token('organisation_equipe') }}">
                                    <select name="role" class="form-control">
                                        {% for role in roles %}
                                            <option value="{{ role }}" {{ membre.role == role ? 'selected' : '' }}>
                                                {{ role|lower|capitalize }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-secondary">Appliquer</button>
                                </form>
                            {% else %}
                                {{ membre.role|lower|capitalize }}
                            {% endif %}
                        </td>
                        <td>{{ membre.createdAt ? membre.createdAt|date('d/m/Y') : '-' }}</td>
                        {% if estProprietaire %}
                            <td>
                                <form method="post" action="{{ path('organisation.equipe.retirer', {id: membre.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('organisation_equipe') }}">
                                    <button type="submit" class="btn btn-sm btn-danger">Retirer</button>
                                </form>
                            </td>
                        {% endif %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </section>

    {% if estProprietaire %}
        <section class="card">
            <h2 class="card-title">Inviter un membre</h2>
            <p class="card-meta">
                La personne doit deja posseder un compte TalChif : son mot de passe ne nous appartient pas.
            </p>

            <form method="post" action="{{ path('organisation.equipe.inviter') }}" class="org-invitation">
                <input type="hidden" name="_token" value="{{ csrf_token('organisation_equipe') }}">

                <div class="form-group">
                    <label class="form-label" for="invitation-email">Adresse email</label>
                    <input class="form-control" type="email" id="invitation-email" name="email" required
                           placeholder="membre@exemple.td" autocomplete="off">
                </div>

                <div class="form-group">
                    <label class="form-label" for="invitation-role">Role</label>
                    <select class="form-control" id="invitation-role" name="role">
                        {% for role in roles %}
                            <option value="{{ role }}">{{ role|lower|capitalize }}</option>
                        {% endfor %}
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">Inviter</button>
            </form>

            <dl class="org-roles-aide">
                <dt>Proprietaire</dt>
                <dd>Gere l'organisation, son equipe et ses evenements.</dd>
                <dt>Gestionnaire</dt>
                <dd>Cree et administre les evenements, sans toucher a l'equipe.</dd>
                <dt>Controleur</dt>
                <dd>Scanne les billets a l'entree, en lecture seule ailleurs.</dd>
            </dl>
        </section>
    {% endif %}
</div>
{% endblock %}
