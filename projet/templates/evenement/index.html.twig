{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/evenement/index.css') }}">
{% endblock %}

{% block title %}Événements - TalChif{% endblock %}

{% block meta_description %}Parcourez notre catalogue d'événements au Tchad. Trouvez votre prochain concert, festival ou soirée et réservez vos billets en ligne.{% endblock %}

{% block body %}

<section class="catalog-page">
    <!-- Feedback de recherche intelligent -->
    {% if search_query and evenements|length == 0 %}
        <div class="search-feedback">
            <div class="search-feedback-header">
                <div class="search-feedback-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="m21 21-4.35-4.35"/>
                        <line x1="11" y1="8" x2="11" y2="14"/>
                        <line x1="8" y1="11" x2="14" y2="11"/>
                    </svg>
                </div>
                <h2 class="search-feedback-title">Aucun événement trouvé pour "{{ search_query }}"</h2>
                <p class="search-feedback-description">Nous n'avons pas trouvé d'événement correspondant exactement à votre recherche.</p>
            </div>

            {% if search_suggestions|length > 0 %}
                <div class="search-suggestions">
                    <h3 class="search-suggestions-title">Essayez ces termes populaires :</h3>
                    <div class="search-suggestions-tags">
                        {% for suggestion in search_suggestions %}
                            <a href="{{ path('evenement.index', {q: suggestion}) }}" class="search-tag">{{ suggestion }}</a>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {% if similar_events|length > 0 %}
                <div class="similar-events-section">
                    <h3 class="similar-events-title">Événements qui pourraient vous intéresser :</h3>
                    <div class="similar-events-grid">
                        {% for evenement in similar_events %}
                            {% set image_path = evenement.image starts with '/' ? evenement.image : '/' ~ evenement.image %}
                            <article class="catalog-card">
                                <a href="{{ path('evenement.show', {slug: evenement.slug, id: evenement.id}) }}" data-turbo="false">
                                    <img src="{{ image_path }}" alt="Affiche de l'événement : {{ evenement.titre }}" 
                                         onerror="this.src='/images/evenements/default-event.jpg';">
                                    <div class="catalog-card-content">
                                        <div class="catalog-card-title">{{ evenement.titre }}</div>
                                        <div class="catalog-card-meta">
                                            {{ evenement.ville }} • {{ evenement.date|date('d/m/Y') }}
                                        </div>
                                        <div class="catalog-card-price">
                                            À partir de {{ evenement.prix_min|number_format(0, '.', ' ') }} XAF
                                        </div>
                                    </div>
                                </a>
                            </article>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            <div class="search-feedback-actions">
                <a href="{{ path('evenement.index') }}" class="btn btn-primary">Voir tous les événements</a>
                <a href="{{ path('accueil') }}" class="btn btn-secondary">Retour à l'accueil</a>
            </div>
        </div>
    {% endif %}

    <!-- Tous les événements -->
    {% if evenements|length > 0 %}
    <section class="category-section">
        <div class="category-header">
            <h2 class="category-title">{% if search_query %}Résultats pour "{{ search_query }}"{% else %}Tous les événements{% endif %}</h2>
            <p class="toolbar-count">{{ evenements|length }} événement(s) trouvé(s)</p>
        </div>
        
        {% if evenements|length > 0 %}
            <div class="category-row">
                {% for evenement in evenements %}
                    {% set image_path = evenement.image starts with '/' ? evenement.image : '/' ~ evenement.image %}
                    <article class="catalog-card">
                        <a href="{{ path('evenement.show', {slug: evenement.slug, id: evenement.id}) }}" data-turbo="false">
                            <img src="{{ image_path }}" alt="Affiche de l'événement : {{ evenement.titre }}" 
                                 onerror="this.src='/images/evenements/default-event.jpg'; console.log('Image manquante: {{ image_path }}');">
                            <div class="catalog-card-content">
                                <div class="catalog-card-title">{{ evenement.titre }}</div>
                                <div class="catalog-card-meta">
                                    {{ evenement.ville }} • {{ evenement.date|date('d/m/Y H:i') }}
                                </div>
                                <div class="catalog-card-price">
                                    À partir de {{ evenement.prix_min|number_format(0, '.', ' ') }} XAF
                                </div>
                            </div>
                        </a>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </section>
    {% endif %}
</section>

{% endblock %}
