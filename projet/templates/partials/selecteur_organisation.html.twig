{# Bascule d'organisation, auto-suffisante : elle interroge le contexte plutot
   que d'exiger des variables de chacun des controleurs du tableau de bord.
   N'apparait qu'au-dela d'un seul rattachement. #}
{% set appartenances = organisations_du_membre() %}
{% set courante = organisation_courante() %}

{% if appartenances|length > 1 %}
    <form method="post" action="{{ path('organisation.basculer') }}" class="org-selecteur">
        <input type="hidden" name="_token" value="{{ csrf_token('organisation_basculer') }}">
        <input type="hidden" name="retour" value="dashboard">
        <label class="sr-only" for="selecteur-organisation">Organisation active</label>
        <select class="form-control" id="selecteur-organisation" name="organisation">
            {% for appartenance in appartenances %}
                <option value="{{ appartenance.organisation.id }}"
                        {{ courante and courante.id == appartenance.organisation.id ? 'selected' : '' }}>
                    {{ appartenance.organisation.nom }}
                </option>
            {% endfor %}
        </select>
        <button type="submit" class="btn btn-sm btn-secondary">Basculer</button>
    </form>
{% elseif courante %}
    <a class="org-selecteur-unique" href="{{ path('organisation.index') }}">{{ courante.nom }}</a>
{% endif %}
