{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/error/403.css') }}">
{% endblock %}

{% block title %}Accès refusé - TalChif{% endblock %}

{% block body %}
<div class="error-page-wrapper">
    <div class="error-page-content-centered">
        <div class="error-page-icon error-icon-warning">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
        </div>
        
        <div class="error-page-code-watermark">403</div>
        <h1 class="error-page-title">Accès refusé</h1>
        <p class="error-page-description">Vous n'avez pas les permissions nécessaires pour accéder à cette page. Cette zone est réservée aux utilisateurs autorisés.</p>
        
        <div class="error-page-info-box">
            <div class="error-page-info-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="16" x2="12" y2="12"/>
                    <line x1="12" y1="8" x2="12.01" y2="8"/>
                </svg>
            </div>
            <div class="error-page-info-text">
                <strong>Que faire ?</strong>
                <ul class="error-suggestions-list">
                    <li><strong>Si vous êtes organisateur</strong> : Connectez-vous avec votre compte organisateur</li>
                    <li><strong>Si vous êtes client</strong> : Accédez aux pages publiques (accueil, événements)</li>
                    <li><strong>Si vous voulez devenir organisateur</strong> : Contactez l'administration</li>
                </ul>
            </div>
        </div>
        
        <div class="error-page-actions">
            <a href="{{ path('accueil') }}" class="btn btn-primary">Retour à l'accueil</a>
            <a href="{{ path('auth.login') }}" class="btn btn-secondary">Se connecter</a>
        </div>
    </div>
</div>

{% endblock %}
