{% extends 'layout/dashboard.html.twig' %}

{% set section = 'admin' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/admin_finance/index.css') }}">
{% endblock %}

{% block title %}Admin - Finance{% endblock %}

{% block dashboard_title %}Finance & paiements{% endblock %}

{% block dashboard_content %}
<p class="page-subtitle">Suivi des transactions, commissions et reversements.</p>

<div class="finance-tabs" data-finance-tabs>
    <div class="finance-tablist" role="tablist" aria-label="Navigation finance">
        <button type="button" class="finance-tab is-active" role="tab" id="finance-tab-summary" aria-controls="finance-panel-summary" aria-selected="true">Synthèse</button>
        <button type="button" class="finance-tab" role="tab" id="finance-tab-transactions" aria-controls="finance-panel-transactions" aria-selected="false" tabindex="-1">Transactions</button>
        <button type="button" class="finance-tab" role="tab" id="finance-tab-settings" aria-controls="finance-panel-settings" aria-selected="false" tabindex="-1">Paramètres</button>
    </div>

    <div class="finance-panel" role="tabpanel" id="finance-panel-summary" aria-labelledby="finance-tab-summary">
        <div class="grid">
            <section class="card">
                <h2 class="card-title">Indicateurs</h2>
                <p class="card-meta">Vue rapide des montants et commandes</p>

                <div class="finance-kpis">
                    <div class="finance-kpi">
                        <div class="finance-kpi-label">Total encaissé</div>
                        <div class="finance-kpi-value">{{ totalEncaisse|number_format(0, '.', ' ') }} FCFA</div>
                    </div>
                    <div class="finance-kpi">
                        <div class="finance-kpi-label">Commissions</div>
                        <div class="finance-kpi-value">{{ totalCommission|number_format(0, '.', ' ') }} FCFA</div>
                    </div>
                    <div class="finance-kpi">
                        <div class="finance-kpi-label">Net organisateurs</div>
                        <div class="finance-kpi-value">{{ totalNetOrganisateurs|number_format(0, '.', ' ') }} FCFA</div>
                    </div>
                    <div class="finance-kpi">
                        <div class="finance-kpi-label">Commandes payées</div>
                        <div class="finance-kpi-value">{{ nbCommandesPaid }}</div>
                    </div>
                    <div class="finance-kpi">
                        <div class="finance-kpi-label">Commandes en attente</div>
                        <div class="finance-kpi-value">{{ nbCommandesPending }}</div>
                    </div>
                </div>
            </section>

            <section class="card">
                <h2 class="card-title">Événements à payer</h2>
                <p class="card-meta">Événements passés dont le reversement organisateur n'est pas encore effectué</p>

                <div class="table-responsive">
                    <table class="table admin-finance-payouts">
                        <thead>
                            <tr>
                                <th>Événement</th>
                                <th>Organisateur</th>
                                <th>Brut</th>
                                <th>Net</th>
                                <th style="width: 160px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in evenementsAPayer %}
                                <tr>
                                    <td>{{ item.evenement.nom }}</td>
                                    <td>{{ item.evenement.organisateur.nom }}</td>
                                    <td style="white-space: nowrap; text-align: right;">{{ item.soldeBrut|number_format(0, '.', ' ') }} FCFA</td>
                                    <td style="white-space: nowrap; text-align: right;">{{ item.soldeNet|number_format(0, '.', ' ') }} FCFA</td>
                                    <td style="white-space: nowrap;">
                                        <form method="post" action="{{ path('admin.commande.settle', {id: item.evenement.id}) }}" style="display:inline;">
                                            <input type="hidden" name="_token" value="{{ csrf_token('settle_' ~ item.evenement.id) }}">
                                            <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('Marquer cet événement comme réglé ?')">Marquer réglé</button>
                                        </form>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="text-center">Aucun événement à payer.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>

    <div class="finance-panel" role="tabpanel" id="finance-panel-transactions" aria-labelledby="finance-tab-transactions" hidden>
        <div class="grid">
            <section class="card">
                <h2 class="card-title">Transactions récentes</h2>
                <p class="card-meta">Historique complet des paiements et commissions</p>
                <p class="card-meta" style="margin-top: -.35rem;">Astuce : utilisez le bouton <strong>Colonnes</strong> pour afficher/masquer les informations secondaires.</p>

                <form method="get" action="{{ path('admin.finance.index') }}" class="admin-finance-filters" style="margin-top: .75rem; display: flex; flex-wrap: wrap; gap: .5rem; align-items: end;">
                    <div style="display: grid; gap: .25rem;">
                        <label for="txn-from" style="font-weight: 800; font-size: .85rem;">Du</label>
                        <input id="txn-from" name="from" type="date" class="auth-input" value="{{ transactionFilters.from ?? '' }}">
                    </div>

                    <div style="display: grid; gap: .25rem;">
                        <label for="txn-to" style="font-weight: 800; font-size: .85rem;">Au</label>
                        <input id="txn-to" name="to" type="date" class="auth-input" value="{{ transactionFilters.to ?? '' }}">
                    </div>

                    <div style="display: grid; gap: .25rem; min-width: 220px;">
                        <label for="txn-status" style="font-weight: 800; font-size: .85rem;">Statut</label>
                        <select id="txn-status" name="status" class="auth-input">
                            <option value="all" {{ (transactionFilters.status ?? 'all') == 'all' ? 'selected' : '' }}>Tous</option>
                            <option value="{{ constant('App\\Entity\\Commande::STATUT_PAID') }}" {{ (transactionFilters.status ?? '') == constant('App\\Entity\\Commande::STATUT_PAID') ? 'selected' : '' }}>Payé</option>
                            <option value="{{ constant('App\\Entity\\Commande::STATUT_PENDING') }}" {{ (transactionFilters.status ?? '') == constant('App\\Entity\\Commande::STATUT_PENDING') ? 'selected' : '' }}>En attente</option>
                            <option value="{{ constant('App\\Entity\\Commande::STATUT_PROCESSING') }}" {{ (transactionFilters.status ?? '') == constant('App\\Entity\\Commande::STATUT_PROCESSING') ? 'selected' : '' }}>En traitement</option>
                            <option value="{{ constant('App\\Entity\\Commande::STATUT_REJECTED') }}" {{ (transactionFilters.status ?? '') == constant('App\\Entity\\Commande::STATUT_REJECTED') ? 'selected' : '' }}>Rejeté</option>
                            <option value="{{ constant('App\\Entity\\Commande::STATUT_EXPIRED') }}" {{ (transactionFilters.status ?? '') == constant('App\\Entity\\Commande::STATUT_EXPIRED') ? 'selected' : '' }}>Expiré</option>
                            <option value="{{ constant('App\\Entity\\Commande::STATUT_CANCELLED') }}" {{ (transactionFilters.status ?? '') == constant('App\\Entity\\Commande::STATUT_CANCELLED') ? 'selected' : '' }}>Annulé</option>
                        </select>
                    </div>

                    <div style="display:flex; gap: .5rem;">
                        <button type="submit" class="btn btn-primary">Filtrer</button>
                        <a class="btn" href="{{ path('admin.finance.index') }}#finance-panel-transactions">Réinitialiser</a>
                    </div>
                </form>
                
                <div class="table-responsive admin-finance-table-wrap">
                <table id="transactions-table" class="table admin-finance-table">
                    <thead>
                        <tr>
                            <th class="col-id">ID</th>
                            <th class="col-event">Événement</th>
                            <th class="col-organizer">Organisateur</th>
                            <th class="col-type">Type</th>
                            <th class="col-amount">Montant</th>
                            <th class="col-commission">Commission</th>
                            <th class="col-method">Moyen</th>
                            <th class="col-date">Date</th>
                            <th class="col-status">Statut</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for commande in transactions %}
                            {% set evenement = commande.premierEvenement %}
                            {% set organisateur = evenement ? evenement.organisateur : null %}
                            {% set dateTxn = commande.dateValidation ?: commande.createdAt %}

                            {% set statut = commande.statut %}
                            {% set statutLabel = statut %}
                            {% set statutPill = 'pill' %}
                            {% if statut == constant('App\\Entity\\Commande::STATUT_PAID') %}
                                {% set statutLabel = 'Payé' %}
                                {% set statutPill = 'pill pill-success admin-finance-pill' %}
                            {% elseif statut in [constant('App\\Entity\\Commande::STATUT_PENDING'), 'Pending'] %}
                                {% set statutLabel = 'En attente' %}
                                {% set statutPill = 'pill pill-warning admin-finance-pill' %}
                            {% elseif statut == constant('App\\Entity\\Commande::STATUT_PROCESSING') %}
                                {% set statutLabel = 'En traitement' %}
                                {% set statutPill = 'pill pill-info admin-finance-pill' %}
                            {% elseif statut == constant('App\\Entity\\Commande::STATUT_REJECTED') %}
                                {% set statutLabel = 'Rejeté' %}
                                {% set statutPill = 'pill pill-error admin-finance-pill' %}
                            {% elseif statut == constant('App\\Entity\\Commande::STATUT_EXPIRED') %}
                                {% set statutLabel = 'Expiré' %}
                                {% set statutPill = 'pill pill-warning admin-finance-pill' %}
                            {% endif %}

                            <tr>
                                <td class="cell-id"><a href="{{ path('admin.finance.transaction_show', {id: commande.id}) }}">{{ commande.reference }}</a></td>
                                <td class="cell-event">{{ evenement ? evenement.nom : '—' }}</td>
                                <td class="cell-organizer">{{ organisateur ? organisateur.nom : '—' }}</td>
                                <td class="cell-type"><span class="pill pill-success admin-finance-pill">Vente</span></td>
                                <td class="cell-amount" style="text-align: right;">{{ commande.montantTotal|number_format(0, '.', ' ') }} FCFA</td>
                                <td class="cell-commission" style="text-align: right;">{{ commande.commissionPlateforme|number_format(0, '.', ' ') }} FCFA</td>
                                <td class="cell-method">{{ commande.methodePaiement }}</td>
                                <td class="cell-date">{{ dateTxn ? dateTxn|date('Y-m-d H:i') : '—' }}</td>
                                <td class="cell-status"><span class="{{ statutPill }}">{{ statutLabel }}</span></td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="9" class="text-center">Aucune transaction.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                </div>
            </section>
        </div>
    </div>

    <div class="finance-panel" role="tabpanel" id="finance-panel-settings" aria-labelledby="finance-tab-settings" hidden>
        <div class="grid">
            <section class="card">
                <h2 class="card-title">Commission standard</h2>
                <p class="card-meta"><span class="pill">{{ (commissionRate * 100)|number_format(0, '.', ' ') }}%</span></p>
                <div class="card-actions">
                    <a class="btn btn-primary" href="{{ path('admin.finance.commission_edit') }}">Modifier</a>
                </div>
            </section>
        </div>
    </div>
</div>

<script>
function initFinanceTabs() {
    const root = document.querySelector('[data-finance-tabs]');
    if (!root || root.dataset.financeTabsBound === '1') return;
    root.dataset.financeTabsBound = '1';

    const tabs = Array.from(root.querySelectorAll('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll('[role="tabpanel"]'));

    function setActiveTab(activeTab) {
        tabs.forEach((tab) => {
            const isActive = tab === activeTab;
            tab.classList.toggle('is-active', isActive);
            tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
            tab.tabIndex = isActive ? 0 : -1;
        });

        panels.forEach((panel) => {
            panel.hidden = panel.id !== activeTab.getAttribute('aria-controls');
        });
    }

    tabs.forEach((tab) => {
        tab.addEventListener('click', () => setActiveTab(tab));
        tab.addEventListener('keydown', (e) => {
            if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
            e.preventDefault();
            const index = tabs.indexOf(tab);
            const dir = e.key === 'ArrowRight' ? 1 : -1;
            const next = tabs[(index + dir + tabs.length) % tabs.length];
            next.focus();
            setActiveTab(next);
        });
    });
}

function initFinanceTransactionsTable() {
    const tableEl = document.getElementById('transactions-table');
    if (!tableEl || tableEl.dataset.dtInit === '1') return;
    tableEl.dataset.dtInit = '1';

    if (typeof DataTableOS === 'undefined') return;
    DataTableOS.init('#transactions-table', {
        order: [[8, 'desc']],
        columns: [
            { width: '92px' },
            null,
            null,
            { width: '112px', orderable: false },
            { width: '120px' },
            { width: '120px' },
            { width: '120px' },
            { width: '120px' },
            { width: '112px', orderable: false }
        ],
        columnDefs: [
            { targets: [2, 3, 6], visible: false }
        ]
    });
}

function initFinancePage() {
    initFinanceTabs();
    initFinanceTransactionsTable();
}

document.addEventListener('DOMContentLoaded', initFinancePage);
document.addEventListener('turbo:load', initFinancePage);
</script>
{% endblock %}
